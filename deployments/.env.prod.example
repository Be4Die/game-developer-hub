# ═══════════════════════════════════════════════════════════════
#  Game Developer Hub — переменные продуктивного стека (docker-compose.prod.yml)
#
#  cp .env.prod.example .env.prod && chmod 600 .env.prod
#  Файл .env.prod не коммитится. Секреты генерируются так:
#    openssl rand -hex 32
#  Сервисы проверяют значения при старте и не запускаются с отладочными
#  или короткими секретами (минимум 32 символа).
# ═══════════════════════════════════════════════════════════════

# ── Домены ──────────────────────────────────────────────────────
# Кабинет разработчика (SPA + API).
GDH_APP_HOST=devhub.example.com
# Отдельный домен для веб-сборок игр и WebSocket-прокси игровых серверов.
# Не должен совпадать с GDH_APP_HOST: игры — недоверенный код.
GDH_GAMES_HOST=games-devhub.example.com
# Кто ещё может встраивать игры в iframe (через пробел), например витрина площадки.
GDH_GAMES_FRAME_ANCESTORS=
# Дополнительные адреса для CSP connect-src игр, через запятую с ведущей запятой:
# ",wss://*.nodes.example.com:*,https://*.nodes.example.com:*"
GDH_EXTRA_PROXY_HOSTS=

# ── Сеть ────────────────────────────────────────────────────────
# Внешняя docker-сеть, в которой работает nginx площадки (TLS + certbot).
PLATFORM_NETWORK=welwise-games-network
# Публикация nginx GDH на хосте (для проверки без внешнего прокси).
GDH_HTTP_BIND=127.0.0.1:8088
# Где слушает gRPC оркестратора для агентов игровых нод.
# Указывайте адрес частной сети/VPN, а не публичный интерфейс.
ORCHESTRATOR_BIND=127.0.0.1:50052

# ── Образы ──────────────────────────────────────────────────────
GDH_IMAGE_PREFIX=gdh-prod-
GDH_IMAGE_TAG=latest
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.46

# ── Секреты инфраструктуры ──────────────────────────────────────
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
# Ключи доступа сервисов к S3 (SeaweedFS). Анонимно читаются только бакеты games и media.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Секреты сервисов ────────────────────────────────────────────
# Общий ключ подписи JWT (HS256): sso подписывает, остальные сервисы проверяют.
JWT_SECRET=
# Ключ межсервисных вызовов (публикация после модерации, приём черновиков, вложения).
INTERNAL_API_KEY=
SSO_API_KEY=
# Подпись одноразовых тикетов скачивания бэкапов. Пусто — случайный ключ при старте
# (тикеты перестают действовать после перезапуска оркестратора).
BACKUP_TICKET_SECRET=

# ── Администратор (создаётся при первом старте sso) ─────────────
ADMIN_EMAIL=
# Не короче 12 символов.
ADMIN_PASSWORD=

# ── Почта (коды подтверждения и сброс пароля) ───────────────────
SMTP_HOST=
# 587 — STARTTLS, 465 — неявный TLS.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ── Интеграции площадки ─────────────────────────────────────────
# disabled — функциональность недоступна (ответ Unavailable), http — реальный сервис.
# Заглушка stub в prod запрещена.
PURCHASE_SERVICE_DRIVER=disabled
PURCHASE_SERVICE_URL=
ANALYTICS_SERVICE_DRIVER=disabled
ANALYTICS_SERVICE_URL=
ANALYTICS_API_KEY=
