--- src/protos/orchestrator/v1/node.proto
+++ src/protos/orchestrator/v1/node.proto
@@ -107,6 +107,37 @@
   rpc DeleteService(NodeServiceDeleteServiceRequest) returns (NodeServiceDeleteServiceResponse) {
     option (google.api.http) = {delete: "/api/v1/nodes/{node_id}/services/{service_id}"};
   }
+
+  // Создать бэкап управляемого сервиса.
+  rpc CreateServiceBackup(NodeServiceCreateServiceBackupRequest) returns (NodeServiceCreateServiceBackupResponse) {
+    option (google.api.http) = {
+      post: "/api/v1/nodes/{node_id}/services/{service_name}/backups"
+      body: "*"
+    };
+  }
+
+  // Получить список бэкапов.
+  rpc ListServiceBackups(NodeServiceListServiceBackupsRequest) returns (NodeServiceListServiceBackupsResponse) {
+    option (google.api.http) = {
+      get: "/api/v1/nodes/{node_id}/services/{service_name}/backups"
+    };
+  }
+
+  // Восстановить бэкап.
+  rpc RestoreServiceBackup(NodeServiceRestoreServiceBackupRequest) returns (NodeServiceRestoreServiceBackupResponse) {
+    option (google.api.http) = {
+      post: "/api/v1/nodes/{node_id}/services/{service_name}/backups/{backup_id}/restore"
+      body: "*"
+    };
+  }
+
+  // Удалить бэкап управляемого сервиса.
+  rpc DeleteServiceBackup(NodeServiceDeleteServiceBackupRequest) returns (NodeServiceDeleteServiceBackupResponse) {
+    option (google.api.http) = {
+      delete: "/api/v1/nodes/{node_id}/services/{service_name}/backups/{backup_id}"
+    };
+  }
+
+  // Сгенерировать одноразовый тикет для защищенного скачивания бэкапа.
+  rpc GetServiceBackupTicket(NodeServiceGetBackupTicketRequest) returns (NodeServiceGetBackupTicketResponse) {
+    option (google.api.http) = {
+      post: "/api/v1/nodes/{node_id}/services/{service_name}/backups/{backup_id}/ticket"
+      body: "*"
+    };
+  }
+
+  // Скачать бэкап управляемого сервиса (стриминг чанков).
+  rpc DownloadServiceBackup(NodeServiceDownloadServiceBackupRequest) returns (stream NodeServiceBackupChunk);
+
+  // Загрузить бэкап управляемого сервиса (стриминг чанков).
+  rpc UploadServiceBackup(stream NodeServiceUploadBackupChunk) returns (NodeServiceUploadBackupResponse);
