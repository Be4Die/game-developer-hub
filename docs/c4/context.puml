@startuml context
!include style.iuml
skinparam nodesep 40
skinparam ranksep 60
actor "<b>Разработчик игры</b>\nпубликует игры, управляет\nсерверами и узлами" as dev
actor "<b>Модератор</b>\nпроверяет заявки" as mod
actor "<b>Администратор</b>\nуправляет учётными\nзаписями" as adm
actor "<b>Игрок</b>\nзапускает игру\nв браузере" as pl

ELEM(sys, "Разрабатываемая система", "программная система", "Публикация и сопровождение веб-игр: проекты, модерация, игровые серверы, вычислительные узлы")

EXT(site, "Площадка Welwise Games", "смежная система", "Каталог игр и страницы игр для игроков")
EXT(mail, "Почтовый сервер", "смежная система", "Доставка писем с кодами подтверждения")
EXT(an, "Сервис аналитики площадки", "смежная система", "Игровые события и показатели")
EXT(pay, "Сервис покупок площадки", "смежная система", "Каталог внутриигровых товаров")
ELEM(node, "Вычислительный узел", "сервер разработчика или площадки", "Выполняет экземпляры игровых серверов и сервисы данных")

dev --> sys : работает в личном\nкабинете, HTTPS
mod --> sys : рассматривает заявки,\nHTTPS
adm --> sys : администрирует,\nHTTPS
pl --> site : выбирает игру
site --> sys : загружает опубликованную\nигру, HTTPS
pl --> sys : подключается к игровому\nсерверу, WebSocket
sys --> mail : отправляет письма,\nSMTP
sys --> an : получает показатели,\nHTTPS
sys --> pay : ведёт товары игры,\nHTTPS
sys --> node : запускает экземпляры,\nопрашивает состояние, gRPC
node --> sys : объявляет себя,\ngRPC
@enduml
