@startuml components-orchestrator
!include style.iuml
skinparam nodesep 25
skinparam ranksep 50
ELEM(gw, "API-шлюз", "контейнер", "Запросы пользователей и клиентов игр")
ELEM(msx, "Сервис модерации", "контейнер", "Выдача доступа к серверам платформы")
ELEM(agx, "Агент узла", "контейнер", "Объявление узла")

rectangle "Сервис оркестрации" as orc #line.dashed {
  rectangle "Транспортный слой" as tl #line.dotted {
    ELEM(auth, "Перехватчики", "gRPC", "Проверка токена, роли, доступа к игре, преобразование ошибок")
    ELEM(h, "Обработчики gRPC", "Go", "Узлы, сборки, экземпляры, политики, обнаружение, очередь")
  }
  rectangle "Слой бизнес-логики" as sl #line.dotted {
    ELEM(nsvc, "Сервис узлов", "Go", "Подключение, роли, внешний доступ, сервисы данных, копии")
    ELEM(bsvc, "Конвейер сборок", "Go", "Приём архива и сборка образа на узле")
    ELEM(isvc, "Сервис экземпляров", "Go", "Запуск, остановка, выбор узла, квоты")
    ELEM(psvc, "Сервис политик", "Go", "Политика оркестрации игры")
    ELEM(dsvc, "Сервис обнаружения", "Go", "Подбор сервера для клиента игры")
    ELEM(qsvc, "Сервис очереди", "Go", "Очередь игроков и закрепление мест")
    ELEM(hb, "Сервис наблюдения", "Go, фоновый цикл", "Опрос узлов, применение политик")
  }
  rectangle "Слой доступа к данным и внешним системам" as dl #line.dotted {
    ELEM(repo, "Хранилища PostgreSQL", "pgx", "Узлы, сборки, экземпляры, политики, события очереди, квоты")
    ELEM(state, "Хранилища состояния", "Valkey", "Состояние узлов и экземпляров, очередь, маршруты")
    ELEM(bst, "Хранилище сборок", "S3 или файловая система", "Архивы серверных сборок")
    ELEM(nc, "Клиент агента узла", "gRPC", "Команды узлу, журналы")
    ELEM(pmc, "Клиент сервиса проектов", "gRPC", "Проверка прав на проект")
  }
}
STORE(pg, "PostgreSQL", "СУБД", "")
STORE(kv, "Valkey", "ключ–значение", "")
STORE(s3, "SeaweedFS", "S3", "")
ELEM(ag, "Агент узла", "контейнер", "Контейнеры на узле")
ELEM(pm, "Сервис управления проектами", "контейнер", "Участники и права")

gw --> auth
msx --> auth
agx --> auth
auth --> h
h --> nsvc
h --> bsvc
h --> isvc
h --> psvc
h --> dsvc
h --> qsvc
dsvc --> isvc
dsvc --> qsvc
hb --> isvc
hb --> qsvc
hb --> psvc
nsvc --> repo
isvc --> repo
isvc --> state
qsvc --> state
hb --> state
bsvc --> bst
bsvc --> nc
isvc --> nc
nsvc --> nc
hb --> nc
auth --> pmc
repo --> pg
state --> kv
bst --> s3
nc --> ag
pmc --> pm
@enduml
