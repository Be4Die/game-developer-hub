}
interface InstanceRepo <<интерфейс>> {
  + Create(instance)
  + GetByID(id) : Instance
  + ListByGame(gameID, status) : []Instance
  + ListByNode(nodeID) : []Instance
  + List() : []Instance
  + Update(instance)
  + Delete(id)
  + CountByGame(gameID) : int
  {method} … ещё 1
}
