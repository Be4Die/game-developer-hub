@startuml orchestrator-services
!include ../uml/style.iuml
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classFontStyle bold
hide circle
left to right direction
skinparam nodesep 30
skinparam ranksep 45
class NodeService {
  --
  + RegisterNode(params) : Node
  + ListNodes(ownerID, status, gameID) : []EnrichedNode
  + GetNode(ownerID, nodeID) : EnrichedNode
  + UpdatePlatformStatus(nodeID, isPlatform) : EnrichedNode
  + DeleteNode(ownerID, nodeID)
  + GetNodeUsage(ownerID, nodeID) : NodeUsageResult
  + AnnounceNode(params) : AnnounceNodeResult
  + ListNodeInstances(ownerID, nodeID) : []EnrichedInstance
  + SyncInstances(nodeID, activeContainerIDs)
  + UpdateRole(ownerID, nodeID, role, …) : Node
  + VerifyDomain(ownerID, nodeID, customDomain) : VerifyDomainResult
  + UpdateIngress(ownerID, nodeID, mode, …) : Node
  {method} … ещё 14
}
class InstanceService {
  --
  + StartInstance(params) : Instance
  + StopInstance(ownerID, gameID, instanceID, timeoutSec) : Instance
  + DeleteInstance(ownerID, gameID, instanceID)
  + RestartInstance(ownerID, gameID, instanceID) : Instance
  + ResumeInstance(ownerID, gameID, instanceID) : Instance
  + ListInstances(ownerID, gameID, status) : []EnrichedInstance
  + GetInstance(ownerID, gameID, instanceID) : EnrichedInstance
  + StreamInstanceLogs(ownerID, gameID, instanceID, req) : LogStream
  + GetInstanceUsage(ownerID, gameID, instanceID) : ResourceUsage
}
class BuildPipeline {
  --
  + UploadBuild(params) : ServerBuild
  + ListBuilds(gameID) : []ServerBuild
  + GetBuild(gameID, version) : ServerBuild
  + DeleteBuild(gameID, version)
}
class GamePolicyService {
  --
  + Get(gameID) : GamePolicy
  + ListAll() : []GamePolicy
}
class DiscoveryService {
  --
  + DiscoverServers(gameID, playerID) : DiscoveryResult
}
class QueueService {
  --
  + Join(gameID, playerID, mode) : QueueStatusResult
  + Heartbeat(gameID, playerID) : QueueStatusResult
  + Leave(gameID, playerID)
  + Status(gameID, playerID) : QueueStatusResult
  + ProcessQueue(gameID)
  + CleanupExpired(gameID, policy) : []string
  + Count(gameID) : int64
}
class HeartbeatService {
  --
  + Run()
  + RestoreInstanceStatuses()
  + EnforcePolicies()
}
class PlatformAccessService {
  --
  + GrantAccess(projectID, maxInstances, maxTotalCPU, …) : PlatformGrant
  + RevokeAccess(projectID)
  + GetGrant(projectID) : PlatformGrant, int32
}
interface NodeRepo <<интерфейс>> {
  + Create(node)
  + Update(node)
  + GetByID(id) : Node
  + GetByAddress(address) : Node
  + List(status) : []Node
  + Delete(id)
  + UpdateLastPing(id)
  + UpdateRole(id, role)
