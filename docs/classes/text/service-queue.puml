@startuml service-queue
!include ../../uml/style.iuml
hide empty members
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classFontStyle bold
hide circle
left to right direction
skinparam nodesep 30
skinparam ranksep 45
class QueueService {
  + Join(gameID, playerID, mode)
  + Heartbeat(gameID, playerID)
  + Leave(gameID, playerID)
  + Status(gameID, playerID)
  + ProcessQueue(gameID)
  + CleanupExpired(gameID, policy)
  + Count(gameID)
}
interface QueueStore <<интерфейс>> {
}
interface QueueEventRepo <<интерфейс>> {
}
class GamePolicyService {
}
interface InstanceRepo <<интерфейс>> {
}
interface InstanceStateStore <<интерфейс>> {
}
interface NodeRepo <<интерфейс>> {
}
QueueService --> QueueStore
QueueService --> QueueEventRepo
QueueService --> GamePolicyService
QueueService --> InstanceRepo
QueueService --> InstanceStateStore
QueueService --> NodeRepo
@enduml
