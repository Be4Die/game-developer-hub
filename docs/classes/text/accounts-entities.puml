@startuml accounts-entities
!include ../../uml/style.iuml
hide empty members
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classFontStyle bold
hide circle
skinparam nodesep 30
skinparam ranksep 45
class User {
  + ID : string
  + Email : string
  + PasswordHash : []byte
  + DisplayName : string
  + Role : UserRole
  + Status : UserStatus
  + EmailVerified : bool
  + CreatedAt : Time
  … ещё 1
}
class Session {
  + ID : string
  + UserID : string
  + UserAgent : string
  + IPAddress : string
  + RefreshTokenHash : string
  + CreatedAt : Time
  + LastUsedAt : Time
  + ExpiresAt : Time
  … ещё 2
}
class TokenPair {
  + AccessToken : string
  + RefreshToken : string
  + ExpiresAt : Time
  + TokenType : string
}
class Claims {
  + UserID : string
  + SessionID : string
  + Email : string
  + Role : UserRole
}
User "1" *-- "*" Session : сессии
Session "1" ..> "1" TokenPair : выдаётся при входе
Claims ..> User
Claims ..> Session
@enduml
