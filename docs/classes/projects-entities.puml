@startuml projects-entities
!include ../uml/style.iuml
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classFontStyle bold
hide circle
skinparam nodesep 30
skinparam ranksep 45
class Project {
  + ID : int64
  + OwnerID : string
  + Status : ProjectStatus
  + IsOnline : bool
  + CreatedAt : Time
  + UpdatedAt : Time
  + Draft : Draft
  + Release : Release
  + CurrentUserPermissions : []string
  + IsOwner : bool
  + IsUnderReview : bool
}
class Draft {
  + ProjectID : int64
  + TitleRu : string
  + TitleEn : string
  + SeoRu : string
  + SeoEn : string
  + AboutRu : string
  + AboutEn : string
  + IconPath : string
  + CoverPath : string
  + VideoPath : string
  + ActiveBuildVersion : string
  + DevURL : string
  … ещё 2
  --
  + IsReadyForModeration()
}
class DraftMeta {
  + TitleRu : string
  + TitleEn : string
  + SeoRu : string
  + SeoEn : string
  + AboutRu : string
  + AboutEn : string
  + ActiveBuildVersion : string
  + IsOnline : bool
}
class Build {
  + ID : int64
  + ProjectID : int64
  + Version : string
  + FilePath : string
  + FileSize : int64
  + IsUnpacked : bool
  + UnpackedPath : string
  + CreatedAt : Time
}
class Release {
  + ID : int64
  + ProjectID : int64
  + Version : string
  + TitleRu : string
  + TitleEn : string
  + SeoRu : string
  + SeoEn : string
  + AboutRu : string
  + AboutEn : string
  + IconPath : string
  + CoverPath : string
  + VideoPath : string
  … ещё 6
}
class DeploymentRecord {
  + ID : int64
  + ProjectID : int64
  + Environment : DeploymentEnvironment
  + Version : string
  + Status : DeploymentStatus
  + ErrorMessage : string
  + DeployedAt : Time
}
class Member {
  + ID : int64
  + ProjectID : int64
  + UserID : string
  + UserEmail : string
  + UserName : string
  + Permissions : []string
  + CreatedAt : Time
  + UpdatedAt : Time
  --
  + HasPermission(perm) : bool
}
class Invitation {
  + ID : int64
  + ProjectID : int64
  + ProjectTitle : string
  + ProjectIcon : string
  + InviterID : string
  + InviterEmail : string
  + InviterName : string
  + InviteeID : string
  + InviteeEmail : string
  + Permissions : []string
  + Status : InvitationStatus
  + CreatedAt : Time
  … ещё 1
}
class UserBlock {
  + ID : int64
  + UserID : string
  + BlockedUserID : string
  + BlockedUserEmail : string
  + BlockedUserName : string
  + CreatedAt : Time
}
class SharedProject {
  + Project : Project
  + Permissions : []string
  + OwnerEmail : string
  + OwnerName : string
  + JoinedAt : Time
}
class GameItem {
  + ID : int64
  + ProjectID : int64
  + GameItemID : string
  + Name : string
  + Description : string
  + ImageURL : string
  + PriceCoins : int64
  + IsActive : bool
  + CreatedAt : Time
  + UpdatedAt : Time
}
enum ProjectStatus <<перечисление>> {
  Draft
  Pending
  Published
  Rejected
}
enum InvitationStatus <<перечисление>> {
  Pending
  Accepted
  Declined
  Canceled
}
enum DeploymentStatus <<перечисление>> {
  Pending
  Success
  Failed
}
Project --> ProjectStatus
Project *-- Draft
Project *-- Release
DeploymentRecord --> DeploymentStatus
Invitation --> InvitationStatus
SharedProject *-- Project
Project "1" *-- "*" Build : содержит
Project "1" *-- "*" Release : содержит
Project "1" *-- "*" DeploymentRecord : журнал
Project "1" *-- "*" Member : участники
Project "1" *-- "*" Invitation : приглашения
Project "1" *-- "*" GameItem : товары
Release "*" --> "1" Build : публикует
Draft "*" --> "0..1" Build : активная сборка
Invitation ..> Member : при принятии
SharedProject --> Project
@enduml
