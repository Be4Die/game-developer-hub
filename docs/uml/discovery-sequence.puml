@startuml discovery-sequence
!include style.iuml
skinparam sequenceMessageAlign center
hide footbox
autonumber
actor "Клиент игры" as CL
participant "API-шлюз" as GW
participant "Сервис\nоркестрации" as OR
database "База данных" as DB
database "Valkey" as KV
participant "Агент узла" as AG
participant "Входной\nпрокси" as IN
participant "Экземпляр\nигрового сервера" as GS
CL -> GW : найти сервер игры
GW -> OR : запрос обнаружения
OR -> DB : работающие и запускаемые\nэкземпляры игры
OR -> KV : число игроков\nна экземплярах
alt есть экземпляр со свободными местами
  OR --> CL : «Готов»: адреса серверов\nпо возрастанию числа игроков
else свободных мест нет, политика разрешает запуск
  OR --> CL : «Запускается»
  OR -> OR : выбрать узел\nс наименьшей загрузкой
  OR -> AG : запустить экземпляр
  AG --> OR : порт экземпляра
  OR -> DB : сохранить экземпляр
  OR -> KV : статус и маршрут экземпляра
  CL -> GW : повторить запрос
  GW -> OR : запрос обнаружения
  OR --> CL : «Готов»: адрес сервера
else достигнут предел экземпляров
  OR --> CL : «Очередь» либо «Нет мест»\nсогласно политике
end
CL -> IN : подключиться по адресу\nэкземпляра (WebSocket)
IN -> KV : найти маршрут экземпляра
IN -> GS : соединить клиента\nс игровым сервером
GS -> AG : сообщить число игроков
@enduml
