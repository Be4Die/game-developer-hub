@startuml node-connect-sequence
!include style.iuml
skinparam sequenceMessageAlign center
hide footbox
autonumber
actor "Разработчик" as Dev
participant "API-шлюз" as GW
participant "Сервис\nоркестрации" as OR
database "База данных" as DB
database "Valkey" as KV
participant "Агент узла" as AG
== Объявление узла ==
AG -> OR : объявить узел: адрес, ключ,\nпроцессор, память, диск
OR -> DB : сохранить узел «Не подтверждён»\nи хеш ключа
OR --> AG : номер узла
== Подтверждение владельцем ==
Dev -> GW : подключить узел,\nуказать ключ узла
GW -> OR : запрос с токеном\nразработчика
OR -> OR : сравнить хеш ключа
OR -> DB : владелец узла,\nстатус «В сети»
OR --> Dev : узел подключён
== Наблюдение за узлом ==
loop каждый интервал проверки
  OR -> AG : запросить состояние узла
  AG --> OR : загрузка ресурсов,\nчисло экземпляров
  OR -> KV : обновить состояние узла
  OR -> AG : запросить список экземпляров
  AG --> OR : статусы, число игроков
  OR -> KV : обновить состояние экземпляров
  OR -> DB : отметить сбой экземпляров,\nкоторых нет на узле
end
alt узел не отвечает дольше тайм-аута
  OR -> DB : узел «Не в сети»,\nего экземпляры «Сбой»
  OR -> OR : перезапуск по политике\nоркестрации
end
@enduml
