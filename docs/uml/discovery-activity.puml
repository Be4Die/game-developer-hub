@startuml discovery-activity
!include style.iuml
start
:Получить запрос клиента игры;
if (за игроком закреплено место?) then (да)
  :Ответ «Место закреплено»:\nадрес сервера;
  stop
else (нет)
endif
:Получить работающие экземпляры\nи число игроков на них;
if (есть экземпляр со свободными местами?) then (да)
  :Ответ «Готов»: адреса по возрастанию\nчисла игроков;
  stop
else (нет)
endif
if (есть запускаемые экземпляры?) then (да)
  :Ответ «Запускается»;
  stop
else (нет)
endif
if (политика игры автоматическая?) then (нет)
  :Ответ «Недоступно»;
  stop
else (да)
endif
if (предел экземпляров не достигнут\nи серверная сборка есть?) then (нет)
  if (политика с очередью?) then (да)
    :Ответ «Очередь»;
  else (нет)
    :Ответ «Нет мест»;
  endif
  stop
else (да)
endif
if (все экземпляры заполнены\nи политика с очередью?) then (да)
  :Ответ «Очередь»;
  stop
else (нет)
endif
:Запустить новый экземпляр\nв фоновом режиме;
:Ответ «Запускается»;
stop
@enduml
