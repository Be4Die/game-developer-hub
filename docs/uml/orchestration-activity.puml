@startuml orchestration-activity
!include style.iuml
start
:Таймер: наступил интервал проверки;
partition "Наблюдение за узлами" {
  while (остались непроверенные узлы?) is (да)
    :Запросить состояние узла;
    if (узел ответил?) then (да)
      :Обновить загрузку узла\nи состояние экземпляров;
      :Отметить сбой экземпляров,\nотсутствующих на узле;
    else (нет)
      if (молчит дольше тайм-аута?) then (да)
        :Перевести узел в «Не в сети»,\nего экземпляры — в «Сбой»;
      else (нет)
      endif
    endif
    if (есть сбойные экземпляры\nи включён автоперезапуск?) then (да)
      :Перезапустить контейнер либо\nзапустить новый экземпляр;
    else (нет)
    endif
  endwhile (нет)
}
partition "Применение политик игр" {
  while (остались игры с автоматической политикой?) is (да)
    if (экземпляров меньше целевого числа\nи предел не достигнут?) then (да)
      :Запустить недостающие экземпляры;
    else (нет)
    endif
    if (режим остановки при простое и экземпляр\nпуст дольше заданного времени?) then (да)
      :Остановить простаивающий экземпляр;
    else (нет)
    endif
    if (экземпляр заполнен либо очередь\nна сервере превысила порог?) then (да)
      :Запустить дополнительный экземпляр;
    else (нет)
    endif
    if (политика с очередью и есть\nсвободное место?) then (да)
      :Закрепить место за первым\nигроком очереди;
    else (нет)
    endif
  endwhile (нет)
}
stop
@enduml
