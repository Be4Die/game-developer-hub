@startuml node-state
!include style.iuml
[*] --> Unauthorized : узел объявил себя\nоркестратору
state "Не подтверждён" as Unauthorized
state "В сети" as Online
state "Не в сети" as Offline
Unauthorized --> Online : владелец подтверждает\nузел
Online --> Offline : нет сигналов\nприсутствия
Offline --> Online : сигналы\nвосстановились
Online --> [*] : удалить узел
Offline --> [*] : удалить узел
@enduml
