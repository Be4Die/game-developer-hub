@startuml node-select-activity
!include style.iuml
start
:Получить серверную сборку\nи предпочтение узла из политики;
:Определить, выдан ли проекту\nдоступ к серверам платформы;
if (указан конкретный узел?) then (да)
  if (узел в сети?) then (нет)
    :Отказ: нет доступного узла;
    stop
  else (да)
  endif
  if (узел платформы?) then (да)
    if (доступ выдан и квота не исчерпана?) then (нет)
      :Отказ: нужен доступ либо\nпревышена квота;
      stop
    else (да)
    endif
  else (нет)
    if (узел принадлежит владельцу сборки?) then (нет)
      :Отказ: чужой узел;
      stop
    else (да)
    endif
  endif
  :Выбрать указанный узел;
else (нет)
  :Отобрать узлы в сети,\nкроме узлов хранения;
  :Оставить свои узлы и узлы платформы\nв пределах квоты;
  if (подходящие узлы есть?) then (нет)
    :Отказ: нет доступного узла;
    stop
  else (да)
  endif
  :Выбрать узел с наименьшим\nчислом экземпляров;
endif
:Проверить ограничения процессора и памяти\nна экземпляр и на проект;
:Передать агенту узла команду запуска;
stop
@enduml
